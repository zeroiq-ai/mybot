TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_AUX_MODEL=google/gemini-2.5-flash
# Path to the SQLite DB. On Railway attach a Volume and set this to a path on it
# (e.g. /data/bot.db) so data survives redeploys. Locally the default is fine.
DB_PATH=bot.db
